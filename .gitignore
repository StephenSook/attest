# Environment
.env
.env.local
.env.*.local

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node
node_modules/
.turbo/
*.tsbuildinfo
frontend/dist/
# A bare `tsc` used to emit JavaScript beside every source file. Vite resolves
# .js before .tsx, so a stale sibling silently shadows the source it was
# compiled from, and an untracked file is one `git add -A` away from the repo.
frontend/src/**/*.js
frontend/src/**/*.js.map

# Databases (local runtime state; seeded fixtures live elsewhere)
data/
*.db
*.db-wal
*.db-shm

# OS / editor
.DS_Store
.AppleDouble
._*
.vscode/
.idea/
*.swp

# Logs and scratch
*.log
tmp/

# pnpm store written by the compose web container into the mounted dir
frontend/.pnpm-store/
frontend/test-results/
.secrets/
