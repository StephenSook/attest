# Copy to .env and fill in real values. Never commit .env.

# CALL-E API credentials (https://github.com/CALLE-AI/call-e-integrations)
CALLE_API_KEY=your-calle-api-key-here
CALLE_API_BASE_URL=https://api.heycall-e.com
# Current CALL-E terminal webhooks are unsigned. Leave this empty unless the
# platform explicitly provisions a signing secret; unsigned hints are always
# confirmed by an authenticated API read.
CALLE_WEBHOOK_SECRET=

# Public base URL of this backend (used to build webhook callback URLs)
ATTEST_PUBLIC_BASE_URL=http://localhost:8000

# Two live-call credentials. The OPERATOR key is unrestricted (the
# builder's own runs). The JUDGE key powers an optional self-service sandbox.
# Production must keep that sandbox disabled until the database is durable
# and destination ownership is enforced. This account completed identity verification.
ATTEST_OPERATOR_KEY=choose-a-long-random-string
ATTEST_JUDGE_KEY=choose-a-different-long-random-string
ATTEST_PHONE_HASH_KEY=choose-a-stable-random-secret
# Sandbox controls. The safe default is closed. Local compose explicitly
# enables it against the mock provider only.
ATTEST_SANDBOX_CAP=15
ATTEST_SANDBOX_ENABLED=0

# SQLite database path
ATTEST_DB_PATH=./data/attest.db

# Set to the mock server during development. No automated test ever dials a real number.
ATTEST_USE_MOCK=true
ATTEST_MOCK_BASE_URL=http://localhost:8100

# Directory of operator-captured run audio (the API exposes no recording URL).
# Files are named <run_id>.m4a|.mp3|.wav. Local files only, never fetched.
ATTEST_AUDIO_DIR=./data/audio

# --- Optional. Every one of these has a working default, so a judge needs none
# of them; they are listed because a config template that omits what the code
# reads is a template that drifts.

# Attestation signing. Empty means certificates are served unsigned and a
# warning is logged. "demo" signs with a DELIBERATELY PUBLIC deterministic key
# so the zero-credential path stays verifiable end to end, which is what
# compose.yml sets. Production sets a real secret: base64 of 32 random bytes,
# generated with
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
ATTEST_SIGNING_KEY_ED25519=demo

# Where the API reads the regenerated evaluation output for /calibration.
ATTEST_METRICS_PATH=eval/results/metrics.json
ATTEST_REAL_CHANNEL_PATH=eval/results/real_channel.json

# Evaluation harness knobs, read by `uv run python -m eval`.
ATTEST_EVAL_N=300
ATTEST_EVAL_OUT=eval/results

# Seeds a short test tone as the probe replay's audio, for checking the player
# without shipping call audio. Off by default.
ATTEST_SEED_TEST_TONE=0

# The operator's own phone, used ONLY by scripts/probe_call.py, which places a
# real call. Never set this to a number you are not authorized to dial. The
# value below is a reserved fictional number and will not connect.
ATTEST_PROBE_PHONE=+15550101234
